IDOC_GUARD_API_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
IDOC_GUARD_ENABLE_OUTBOUND=true
IDOC_GUARD_ENABLE_INBOUND=true
IDOC_GUARD_ENABLE_INBOUND_PAYLOAD_READ=false
IDOC_GUARD_STATE_DIR=/var/lib/sap-idoc-guard
IDOC_GUARD_MAX_BODY_BYTES=262144
IDOC_GUARD_REQUEST_TIMEOUT_SECONDS=60
IDOC_GUARD_TLS_KEYSTORE=/run/secrets/idoc-guard-keystore.p12
IDOC_GUARD_TLS_KEYSTORE_PASSWORD=REPLACE
IDOC_GUARD_HEALTH_HOST=localhost

SAP_DESTINATION_NAME=SAP_IDOC_GUARD
SAP_ASHOST=REPLACE
SAP_SYSNR=00
SAP_CLIENT=100
SAP_USER=REPLACE_LEAST_PRIVILEGE_USER
SAP_PASSWORD=REPLACE
SAP_LANG=EN
SAP_POOL_CAPACITY=3
SAP_PEAK_LIMIT=10

IDOC_OUTBOUND_OPERATION=submitPurchaseOrderIdoc
IDOC_MESSAGE_TYPE=ORDERS
IDOC_BASIC_TYPE=ORDERS05
IDOC_EXTENSION=
IDOC_ALLOWED_SEGMENTS=EDI_DC40,E1EDK01,E1EDKA1,E1EDP01,E1EDP19
IDOC_GUARD_MAX_SEGMENTS=500
IDOC_SENDER_PARTNER_TYPE=LS
IDOC_SENDER_PARTNER=N8N
IDOC_RECEIVER_PARTNER_TYPE=LS
IDOC_RECEIVER_PARTNER=S4DCLNT100
IDOC_RECEIVER_PORT=S4DCLNT100

SAP_SERVER_NAME=SAP_IDOC_GUARD_SERVER
SAP_GWHOST=REPLACE
SAP_GWSERV=sapgw00
SAP_PROGRAM_ID=N8N_IDOC_GUARD
SAP_SERVER_CONNECTION_COUNT=2
IDOC_INBOUND_MESSAGE_TYPES=DESADV,INVOIC
IDOC_INBOUND_BASIC_TYPES=DELVRY07,INVOIC02
IDOC_INBOUND_SENDER_PARTNERS=SUPPLIER_1000,SUPPLIER_2000
IDOC_INBOUND_MAX_BYTES=1048576
